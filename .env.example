# 이 파일을 .env 로 복사한 뒤 값을 채우세요.
# .env 는 커밋되지 않습니다 (.gitignore).
#
# 선택 항목은 주석 그대로 두세요. `KEY=` 처럼 비워 두면 빈 문자열이
# 기본값을 덮어써서 동작하지 않습니다.

# --- 필수 ---

# 이슈 조회·생성용 personal access token
# public 저장소만 다루면 public_repo 스코프면 충분합니다.
GITHUB_TOKEN=

# LLM 호출용 키. 쓰는 제공자 쪽만 채우면 됩니다.
# 임베딩은 Anthropic이 지원하지 않으므로 OPENAI_API_KEY 가 항상 필요합니다.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- 선택 ---

# 커밋 메시지 생성에 쓸 모델. `제공자:모델` 형식 (기본값 anthropic:claude-sonnet-5)
#COMMIT_AGENT_MODEL=openai:gpt-5

# 추론 모델이 생각에 쓸 분량 (기본값 minimal)
# 추론 모델은 짧은 답에도 생각을 길게 해서 커밋이 느려집니다.
# 추론을 지원하지 않는 모델을 쓸 때는 빈 값으로 두지 말고 주석 처리하세요.
#COMMIT_AGENT_REASONING_EFFORT=minimal

# 임베딩 모델과 차원 (기본값 openai:text-embedding-3-large, 모델 기본 차원)
#COMMIT_AGENT_EMBEDDING_MODEL=openai:text-embedding-3-large
#COMMIT_AGENT_EMBEDDING_DIMENSIONS=3072

# 로컬 벡터 스토어 위치 (기본값 .commit-agent/qdrant)
#COMMIT_AGENT_VECTOR_STORE_PATH=.commit-agent/qdrant

# 공유 벡터 스토어 주소. 지정하면 로컬 대신 여기에 붙습니다.
#COMMIT_AGENT_VECTOR_STORE_URL=http://localhost:6333
